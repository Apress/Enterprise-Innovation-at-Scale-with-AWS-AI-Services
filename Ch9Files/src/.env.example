# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Nova Act API key — obtain at https://nova.amazon.com/act
# Required only if using --sub-agent nova-act (the default).
NOVA_ACT_API_KEY=your-key-here

# Optional: enable persistent local checkpointing.
# When unset, local runs use in-process MemorySaver (does NOT survive restarts).
# Set this to the memory_id printed by `python setup_resources.py --create` to
# checkpoint into AgentCore Memory across local runs. On deployed runtimes
# this is injected automatically by deploy.py — you do not need to set it
# in .env for production.
# AGENTCORE_MEMORY_ID=your-memory-id
